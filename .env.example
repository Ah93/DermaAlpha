# ── LLM backend ──────────────────────────────────────────────────────────────
# "gemini" (default, Google Gemini API) | "ollama" (local Ollama server)
# "api" (HuggingFace Inference API)     | "local" (transformers, needs a GPU)
HF_INFERENCE_MODE=gemini

# Gemini (used when HF_INFERENCE_MODE=gemini). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Ollama (used when HF_INFERENCE_MODE=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llava:7b

# HuggingFace (used when HF_INFERENCE_MODE=api or local)
# Get at https://huggingface.co/settings/tokens (READ permission) and request access to
#   https://huggingface.co/google/medgemma-4b-it
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_MODEL_ID=google/medgemma-4b-it

# ── Pinecone ─────────────────────────────────────────────────────────────────
# Get at https://app.pinecone.io
PINECONE_API_KEY=pcsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloud provider and region for the Pinecone index (free tier: aws + us-east-1)
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Name of the Pinecone index (created automatically on first run)
PINECONE_INDEX_NAME=derma-encounters-v2

# ── Embedding Model ───────────────────────────────────────────────────────────
# Biomedical sentence-transformers model for encounter text (768-d).
# BioMedCLIP image vectors (512-d) are zero-padded to EMBEDDING_DIM, so keep it >= 512.
EMBEDDING_MODEL=pritamdeka/S-PubMedBert-MS-MARCO
EMBEDDING_DIM=768

# ── Application ───────────────────────────────────────────────────────────────
# Maximum number of past encounters to retrieve for follow-up context
MAX_RETRIEVED_ENCOUNTERS=5

# Cosine similarity threshold (0.0–1.0); encounters below this are deprioritised
SIMILARITY_THRESHOLD=0.65

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Directory for temporary image cache
IMAGE_CACHE_DIR=./image_cache

# Maximum image dimension (pixels) before resizing
MAX_IMAGE_DIM=896
