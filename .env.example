# ── HuggingFace ──────────────────────────────────────────────────────────────
# Get at https://huggingface.co/settings/tokens  (needs READ permission)
# You must also request access to the model at:
#   https://huggingface.co/google/medgemma-4b-it
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model identifier on HuggingFace Hub
HF_MODEL_ID=google/medgemma-4b-it

# Inference mode: "api" uses HuggingFace Inference API (requires HF Pro or Inference Endpoint)
#                 "local" downloads weights locally (needs ~8 GB VRAM with 4-bit quant)
HF_INFERENCE_MODE=api

# ── Pinecone ─────────────────────────────────────────────────────────────────
# Get at https://app.pinecone.io
PINECONE_API_KEY=pcsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloud provider and region for the Pinecone index (free tier: aws + us-east-1)
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Name of the Pinecone index (created automatically on first run)
PINECONE_INDEX_NAME=derma-encounters

# ── Embedding Model ───────────────────────────────────────────────────────────
# Sentence-transformers model used for text embeddings stored in Pinecone
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── Application ───────────────────────────────────────────────────────────────
# Maximum number of past encounters to retrieve for follow-up context
MAX_RETRIEVED_ENCOUNTERS=5

# Cosine similarity threshold (0.0–1.0); encounters below this are deprioritised
SIMILARITY_THRESHOLD=0.65

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Directory for temporary image cache
IMAGE_CACHE_DIR=./image_cache

# Maximum image dimension (pixels) before resizing; MedGemma works well at 896
MAX_IMAGE_DIM=896
